{
  "name": "liground",
  "version": "0.4.0",
  "author": "Johannes Czech (johannes.czech@cs.tu-darmstadt.de)",
  "description": "A mordern Chess Variant Analysis GUI for the 21st century",
  "license": "AGPL-3.0",
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "node scripts/build.js && electron-builder",
    "build:dir": "node scripts/build.js && electron-builder --dir",
    "build:clean": "cross-env BUILD_TARGET=clean node scripts/build.js",
    "build:web": "cross-env BUILD_TARGET=web node scripts/build.js",
    "dev": "node scripts/dev-runner.js",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src",
    "pack": "npm run pack:main && npm run pack:renderer",
    "pack:main": "cross-env NODE_ENV=production webpack --progress --config webpack/main.config.js",
    "pack:renderer": "cross-env NODE_ENV=production webpack --progress --config webpack/renderer.config.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@imengyu/vue3-context-menu": "^1.4.8",
    "apexcharts": "^3.24.0",
    "chessgroundx": "^8.3.0",
    "electron-is-dev": "^2.0.0",
    "ffish": "^0.7.7",
    "pretty-checkbox": "^3.0.3",
    "vue": "^3.5.13",
    "vue-apexcharts": "^1.6.0",
    "vue-electron": "^1.0.6",
    "vue-multiselect": "^3.2.0",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0",
    "vuex-electron": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/eslint-parser": "^7.12.1",
    "@babel/plugin-transform-runtime": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@babel/register": "^7.12.10",
    "ajv": "^6.5.0",
    "babel-loader": "^8.2.2",
    "cfonts": "^2.9.0",
    "chalk": "^2.4.1",
    "copy-webpack-plugin": "^7.0.0",
    "cross-env": "^5.1.6",
    "css-loader": "^5.0.1",
    "del": "^3.0.0",
    "electron": "^35.1.1",
    "electron-builder": "^26.0.12",
    "electron-debug": "^3.1.0",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^7.18.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-plugin-html": "^6.1.1",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-vue": "^7.5.0",
    "eslint-webpack-plugin": "^2.4.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^1.3.4",
    "multispinner": "^0.2.1",
    "node-loader": "^1.0.2",
    "style-loader": "^2.0.0",
    "url-loader": "^4.1.1",
    "vue-eslint-parser": "^7.4.1",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.0",
    "vue-template-compiler": "^2.6.12",
    "webpack": "^5.98.0",
    "webpack-cli": "^4.4.0",
    "webpack-dev-middleware": "^4.1.0",
    "webpack-dev-server": "^5.2.1",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-merge": "^5.7.0",
    "worker-loader": "^3.0.7"
  }
}
